# Optional: enable the real-LLM agent mode (`--llm`). Without a key, the agent
# runs in deterministic mode, which is fully reproducible and used by the tests.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used in --llm mode (default: claude-opus-4-8).
MODEL=claude-opus-4-8

# Speculos HTTP API base URL (defaults to http://localhost:5001).
# Port 5001 avoids macOS's AirPlay Receiver, which holds port 5000.
SPECULOS_URL=http://localhost:5001
